{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "45rem",
			"wideSize": "86rem"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"defaultDuotone": false,
			"duotone": [],
			"gradients": [],
			"palette": [
				{ "slug": "bg", "name": "Background", "color": "#F7F5F0" },
				{ "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
				{ "slug": "surface-sunken", "name": "Surface sunken", "color": "#EFEDE5" },
				{ "slug": "ink-900", "name": "Ink 900", "color": "#26251F" },
				{ "slug": "ink-700", "name": "Ink 700", "color": "#57544C" },
				{ "slug": "ink-500", "name": "Ink 500", "color": "#8B887C" },
				{ "slug": "ink-300", "name": "Ink 300", "color": "#C9C5B7" },
				{ "slug": "line", "name": "Line", "color": "#E6E2D5" },
				{ "slug": "footer-bg", "name": "Footer", "color": "#211F1A" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"textTransform": false,
			"fontFamilies": [
				{ "slug": "display", "name": "IvyOra Display", "fontFamily": "ivyora-display, Georgia, \"Times New Roman\", serif" },
				{ "slug": "text", "name": "IvyOra Text", "fontFamily": "ivyora-text, Georgia, \"Times New Roman\", serif" },
				{ "slug": "body", "name": "Parabolica", "fontFamily": "parabolica, Arial, \"Helvetica Neue\", Helvetica, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "meta", "name": "Meta", "size": "0.75rem" },
				{ "slug": "compact", "name": "Compact", "size": "0.8125rem" },
				{ "slug": "body", "name": "Body", "size": "1rem" },
				{ "slug": "lead", "name": "Lead", "size": "1.25rem" },
				{ "slug": "h4", "name": "Heading 4", "size": "1.25rem" },
				{ "slug": "h3", "name": "Heading 3", "size": "1.5625rem" },
				{ "slug": "h2", "name": "Heading 2", "size": "1.875rem" },
				{ "slug": "h1", "name": "Heading 1", "size": "2.625rem" },
				{ "slug": "hero", "name": "Hero", "size": "4.375rem" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "slug": "1", "name": "4", "size": "4px" },
				{ "slug": "2", "name": "8", "size": "8px" },
				{ "slug": "3", "name": "12", "size": "12px" },
				{ "slug": "4", "name": "16", "size": "16px" },
				{ "slug": "5", "name": "24", "size": "24px" },
				{ "slug": "6", "name": "32", "size": "32px" },
				{ "slug": "7", "name": "48", "size": "48px" },
				{ "slug": "8", "name": "64", "size": "64px" },
				{ "slug": "9", "name": "96", "size": "96px" }
			]
		},
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--ink-900)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "500",
					"letterSpacing": "-0.012em"
				},
				"color": { "text": "var(--wp--preset--color--ink-900)" }
			},
			"h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--h1)", "lineHeight": "1.15" } },
			"h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--h2)", "lineHeight": "1.15" } },
			"h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--text)", "fontSize": "var(--wp--preset--font-size--h3)", "lineHeight": "1.2" } },
			"h4": { "typography": { "fontFamily": "var(--wp--preset--font-family--text)", "fontSize": "var(--wp--preset--font-size--h4)", "lineHeight": "1.25" } },
			"link": {
				"color": { "text": "var(--accent-ink, #26251F)" }
			}
		}
	}
}
